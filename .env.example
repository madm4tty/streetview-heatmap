# Copy to .env for local pipeline runs. Never commit .env.
# The monthly GitHub Actions build reads the same names from repository secrets.

# Street View metadata lookups (free, but the key's project needs billing enabled).
# Restrict the key to the Street View Static API.
GOOGLE_MAPS_API_KEY=your_api_key_here

# Cloudflare R2 (only needed for publish, pull-state and push-state)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Secret folder the map is published under: 16+ random letters, digits, - or _
R2_SITE_PREFIX=
# Optional overrides
# R2_BUCKET=streetview-heatmap
# R2_STATE_BUCKET=streetview-heatmap-state
